<launch>
  <node pkg="hdl_localization" type="imu_filter_node" name="imu_filter_node" output="screen">
     <param name="process_noise" value="0.95" />
     <param name="measurement_noise" value="0.075" />
     <param name="initial_covariance" value="0.01" />
     <!-- <param name="gyro_bias_random_walk" value="0.0001" />  
     <param name="accel_bias_random_walk" value="0.001" />
     <param name="sample_rate" value="200.0" />
     <param name="alpha_accel" value="0.02" />
     <param name="alpha_gyro" value="0.05" />
     <param name="bias_estimation_rate" value="0.001" /> -->
  </node>
</launch> 

